# Copy to .env and replace the placeholders. .env is gitignored.

# Temporal dev server (gRPC) and web UI, published on the host
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
TEMPORAL_NAMESPACE=default

# Postgres 17 + pgvector, application database
POSTGRES_PORT=5432
POSTGRES_DB=football_intel
POSTGRES_USER=football_intel
POSTGRES_PASSWORD=change-me
